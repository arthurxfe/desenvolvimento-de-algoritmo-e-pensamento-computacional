    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="antes de tudo, leia o comentario usado na direita do projeto, antes do menu"/>
            <comment text="Declare as novas variaveis nesse local e atribua dentro das op&#231;&#245;es!!!!!!!!"/>
            <declare name="opcao" type="Integer" array="False" size=""/>
            <declare name="num1, num2, resultado, a, b, c, x, y, celsius, fahrenheit, raio, base, altura, area, p, euler, cub, numero, resto" type="Real" array="False" size=""/>
            <declare name="resposta" type="String" array="False" size=""/>
            <assign variable="resposta" expression="&quot;S&quot;"/>
            <do expression="resposta == &quot;S&quot; or resposta == &quot;s&quot;">
                <output expression="&quot;Selecione uma das op&#231;&#245;es abaixo: &quot;" newline="True"/>
                <comment text="Pegue sua parte e modifique o texto abaixo e adicione os calculos nas op&#231;&#245;es, lembre que as variaveis est&#227;o declaradas ali em cima(a, b, c, x, y, z e resultado)"/>
                <output expression="&quot;1 - Soma | 2 - Subtra&#231;&#227;o | 3 - Divis&#227;o | 4 - Multiplica&#231;&#227;o&quot;" newline="True"/>
                <output expression="&quot;5 - Logaritmo base 10 | 6 - Logaritmo natural | 7 - Fatorial | 8 - M&#243;dulo&quot;" newline="True"/>
                <output expression="&quot;9 - Potencia&#231;&#227;o | 10 - Raiz quadrada | 11 - Porcentagem | 12 - M&#233;dia&quot;" newline="True"/>
                <output expression="&quot;13 - Celsius para Fahrenheit | 14 - Fahrenheit para Celsius | 15 - &#193;rea do C&#237;rculo | 16 - &#193;rea do tri&#226;ngulo&quot;" newline="True"/>
                <output expression="&quot;17 - Constante de PI | 18 - Constante de Euler | 19 - Raiz c&#250;bica | 20 - Resto de divis&#227;o&quot;" newline="True"/>
                <input variable="opcao"/>
                <if expression="opcao== 1">
                    <then>
                        <output expression="&quot;Insira o primeiro numero da soma: &quot;" newline="True"/>
                        <input variable="a"/>
                        <output expression="&quot;Insira o segundo numero da soma:&quot;" newline="True"/>
                        <input variable="b"/>
                        <assign variable="resultado" expression="a+b"/>
                        <output expression="&quot;O resultado da soma &#233;:&quot; &amp;resultado" newline="True"/>
                    </then>
                    <else>
                        <if expression="opcao== 2">
                            <then>
                                <output expression="&quot;Insira o primeiro numero da subtra&#231;&#227;o: &quot;" newline="True"/>
                                <input variable="a"/>
                                <output expression="&quot;Insira o segundo numero da subtra&#231;&#227;o:&quot;" newline="True"/>
                                <input variable="b"/>
                                <assign variable="resultado" expression="a-b"/>
                                <output expression="&quot;O resultado da subtra&#231;&#227;o &#233;:&quot; &amp;resultado" newline="True"/>
                            </then>
                            <else>
                                <if expression="opcao== 3">
                                    <then>
                                        <output expression="&quot;Insira o primeiro numero da divis&#227;o: &quot;" newline="True"/>
                                        <input variable="a"/>
                                        <output expression="&quot;Insira o segundo numero da divis&#227;o:&quot;" newline="True"/>
                                        <input variable="b"/>
                                        <assign variable="resultado" expression="a/b"/>
                                        <output expression="&quot;O resultado da divis&#227;o &#233;:&quot; &amp;resultado" newline="True"/>
                                    </then>
                                    <else>
                                        <if expression="opcao== 4">
                                            <then>
                                                <output expression="&quot;Insira o primeiro numero da multiplica&#231;&#227;o: &quot;" newline="True"/>
                                                <input variable="a"/>
                                                <output expression="&quot;Insira o segundo numero da multiplica&#231;&#227;o:&quot;" newline="True"/>
                                                <input variable="b"/>
                                                <assign variable="resultado" expression="a*b"/>
                                                <output expression="&quot;O resultado da multiplica&#231;&#227;o &#233;:&quot; &amp;resultado" newline="True"/>
                                            </then>
                                            <else>
                                                <if expression="opcao== 5">
                                                    <then>
                                                        <input variable="x"/>
                                                        <assign variable="resultado" expression="Log10(x)"/>
                                                        <output expression="&quot;O resultado do Log base 10 &#233;:&quot; &amp;resultado" newline="True"/>
                                                    </then>
                                                    <else>
                                                        <if expression="opcao == 6">
                                                            <then>
                                                                <input variable="x"/>
                                                                <assign variable="resultado" expression="Log(x)"/>
                                                                <output expression="&quot;O resultado do natural (in) &#233;:&quot; &amp;resultado" newline="True"/>
                                                            </then>
                                                            <else>
                                                                <if expression="opcao == 7">
                                                                    <then>
                                                                        <declare name="i, fact" type="Real" array="False" size=""/>
                                                                        <input variable="x"/>
                                                                        <assign variable="fact" expression="1"/>
                                                                        <assign variable="i" expression="1"/>
                                                                        <while expression="i &lt;= x">
                                                                            <assign variable="fact" expression="fact * i"/>
                                                                            <assign variable="i" expression="i + 1"/>
                                                                        </while>
                                                                        <output expression="&quot;O fatorial &#233;: &quot; &amp;fact" newline="True"/>
                                                                    </then>
                                                                    <else>
                                                                        <if expression="opcao == 8">
                                                                            <then>
                                                                                <declare name="n" type="Real" array="False" size=""/>
                                                                                <input variable="x"/>
                                                                                <input variable="n"/>
                                                                                <assign variable="resultado" expression="x Mod n"/>
                                                                                <output expression="&quot;O resultado do modulo &#233;:&quot; &amp;resultado" newline="True"/>
                                                                            </then>
                                                                            <else>
                                                                                <if expression="opcao == 9">
                                                                                    <then>
                                                                                        <output expression="&quot;Digite a base:&quot;" newline="True"/>
                                                                                        <input variable="a"/>
                                                                                        <output expression="&quot;Digite o expoente:&quot;" newline="True"/>
                                                                                        <input variable="b"/>
                                                                                        <assign variable="resultado" expression="a ^ b"/>
                                                                                        <output expression="&quot;O resultado da potencia&#231;&#227;o &#233;: &quot; &amp;resultado" newline="True"/>
                                                                                    </then>
                                                                                    <else>
                                                                                        <if expression="opcao == 10">
                                                                                            <then>
                                                                                                <output expression="&quot;Digite o n&#250;mero: &quot;" newline="True"/>
                                                                                                <input variable="x"/>
                                                                                                <assign variable="resultado" expression="Sqrt(x)"/>
                                                                                                <output expression="&quot;A raiz quadrada &#233;: &quot; &amp;resultado" newline="True"/>
                                                                                            </then>
                                                                                            <else>
                                                                                                <if expression="opcao== 11">
                                                                                                    <then>
                                                                                                        <output expression="&quot;Digite o valor: &quot;" newline="True"/>
                                                                                                        <input variable="a"/>
                                                                                                        <output expression="&quot;Digite a porcentagem: &quot;" newline="True"/>
                                                                                                        <input variable="b"/>
                                                                                                        <assign variable="resultado" expression="a * b / 100"/>
                                                                                                        <output expression="&quot;O resultado da porcentagem &#233;: &quot; &amp;resultado" newline="True"/>
                                                                                                    </then>
                                                                                                    <else>
                                                                                                        <if expression="opcao== 12">
                                                                                                            <then>
                                                                                                                <output expression="&quot;Digite o primeiro n&#250;mero: &quot;" newline="True"/>
                                                                                                                <input variable="a"/>
                                                                                                                <output expression="&quot;Digite o segundo n&#250;mero: &quot;" newline="True"/>
                                                                                                                <input variable="b"/>
                                                                                                                <assign variable="resultado" expression="(a + b) / 2"/>
                                                                                                                <output expression="&quot;A m&#233;dia &#233;: &quot; &amp;resultado" newline="True"/>
                                                                                                            </then>
                                                                                                            <else>
                                                                                                                <if expression="opcao== 13">
                                                                                                                    <then>
                                                                                                                        <output expression="&quot;Digite a temperatura em Celsius:&quot;" newline="True"/>
                                                                                                                        <input variable="celsius"/>
                                                                                                                        <assign variable="fahrenheit" expression="(celsius * 9 / 5) + 32"/>
                                                                                                                        <output expression="&quot;Temperatura em Fahrenheit: &quot; &amp; fahrenheit" newline="True"/>
                                                                                                                    </then>
                                                                                                                    <else>
                                                                                                                        <if expression="opcao== 14">
                                                                                                                            <then>
                                                                                                                                <output expression="&quot;Digite a Temperatura em Fahrenheit:&quot;" newline="True"/>
                                                                                                                                <input variable="fahrenheit"/>
                                                                                                                                <assign variable="celsius" expression="(fahrenheit - 32) * 5 / 9"/>
                                                                                                                                <output expression="&quot;Temperatura em Celsius: &quot; &amp; celsius" newline="True"/>
                                                                                                                            </then>
                                                                                                                            <else>
                                                                                                                                <if expression="opcao== 15">
                                                                                                                                    <then>
                                                                                                                                        <output expression="&quot;Digite o raio do c&#237;rculo: &quot;" newline="True"/>
                                                                                                                                        <input variable="raio"/>
                                                                                                                                        <assign variable="area" expression="3.14159 * raio * raio"/>
                                                                                                                                        <output expression="&quot;&#193;rea do c&#237;rculo: &quot; &amp; area" newline="True"/>
                                                                                                                                    </then>
                                                                                                                                    <else>
                                                                                                                                        <if expression="opcao == 16">
                                                                                                                                            <then>
                                                                                                                                                <output expression="&quot;Digite a base do tri&#226;ngulo:&quot;" newline="True"/>
                                                                                                                                                <input variable="base"/>
                                                                                                                                                <output expression="&quot;Digite a altura do tri&#226;ngulo:&quot;" newline="True"/>
                                                                                                                                                <input variable="altura"/>
                                                                                                                                                <assign variable="area" expression="(base * altura) / 2"/>
                                                                                                                                                <output expression="&quot;&#193;rea do tri&#226;ngulo: &quot; &amp; area" newline="True"/>
                                                                                                                                            </then>
                                                                                                                                            <else>
                                                                                                                                                <if expression="opcao == 17">
                                                                                                                                                    <then>
                                                                                                                                                        <assign variable="p" expression="3.14159"/>
                                                                                                                                                        <output expression="&quot;A constante de PI &#233;: &quot;&amp;p" newline="True"/>
                                                                                                                                                    </then>
                                                                                                                                                    <else>
                                                                                                                                                        <if expression="opcao == 18">
                                                                                                                                                            <then>
                                                                                                                                                                <assign variable="euler" expression="0.5772156649"/>
                                                                                                                                                                <output expression="&quot;A constante de Euler &#233;: &quot;&amp;euler" newline="True"/>
                                                                                                                                                            </then>
                                                                                                                                                            <else>
                                                                                                                                                                <if expression="opcao == 19">
                                                                                                                                                                    <then>
                                                                                                                                                                        <output expression="&quot;Digite o n&#250;mero: &quot;" newline="True"/>
                                                                                                                                                                        <input variable="numero"/>
                                                                                                                                                                        <assign variable="cub" expression="numero^3"/>
                                                                                                                                                                        <output expression="&quot;O resultado ser&#225;: &quot;&amp;cub" newline="True"/>
                                                                                                                                                                    </then>
                                                                                                                                                                    <else>
                                                                                                                                                                        <if expression="opcao == 20">
                                                                                                                                                                            <then>
                                                                                                                                                                                <output expression="&quot;Digite o primeiro n&#250;mero: &quot;" newline="True"/>
                                                                                                                                                                                <input variable="num1"/>
                                                                                                                                                                                <output expression="&quot;Digite o segundo n&#250;mero: &quot;" newline="True"/>
                                                                                                                                                                                <input variable="num2"/>
                                                                                                                                                                                <assign variable="resto" expression="num1 mod num2"/>
                                                                                                                                                                                <output expression="&quot;O resto da divis&#227;o ser&#225;: &quot;&amp;resto" newline="True"/>
                                                                                                                                                                            </then>
                                                                                                                                                                            <else>
                                                                                                                                                                                <output expression="&quot;Op&#231;&#227;o inv&#225;lida!&quot;" newline="True"/>
                                                                                                                                                                            </else>
                                                                                                                                                                        </if>
                                                                                                                                                                    </else>
                                                                                                                                                                </if>
                                                                                                                                                            </else>
                                                                                                                                                        </if>
                                                                                                                                                    </else>
                                                                                                                                                </if>
                                                                                                                                            </else>
                                                                                                                                        </if>
                                                                                                                                    </else>
                                                                                                                                </if>
                                                                                                                            </else>
                                                                                                                        </if>
                                                                                                                    </else>
                                                                                                                </if>
                                                                                                            </else>
                                                                                                        </if>
                                                                                                    </else>
                                                                                                </if>
                                                                                            </else>
                                                                                        </if>
                                                                                    </else>
                                                                                </if>
                                                                            </else>
                                                                        </if>
                                                                    </else>
                                                                </if>
                                                            </else>
                                                        </if>
                                                    </else>
                                                </if>
                                            </else>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
                <output expression="&quot;Deseja fazer outro calculo?(S/N)&quot;" newline="True"/>
                <input variable="resposta"/>
            </do>
            <output expression="&quot;At&#233; a proxima inicializa&#231;&#227;o!&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>